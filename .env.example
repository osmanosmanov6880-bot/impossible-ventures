# Copy to .env (never commit .env).
# Optional model-assisted creative editing. No model is used unless both
# agents independently opt in within an active mission.
OPENAI_API_KEY=
# Select a model that supports the Responses API and strict JSON schema output.
# Example (confirm access and current pricing in your OpenAI Platform account):
OPENAI_MODEL=gpt-4.1-mini

# Required for the two operator screens: /pilot/operator/ and /experiments/operator/.
# Use a cryptographically random 32+ character secret. Never commit the actual value.
# Example: node -e "process.stdout.write(require('node:crypto').randomBytes(48).toString('base64url'))"
OPERATOR_TOKEN=

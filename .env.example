# Copy to .env (never commit .env).
# Optional model-assisted creative editing. No model is used unless both
# agents independently opt in within an active mission.
OPENAI_API_KEY=
# Select a model that supports the Responses API and strict JSON schema output.
# Example (confirm access and current pricing in your OpenAI Platform account):
OPENAI_MODEL=gpt-4.1-mini

# Optional Pilot Studio operator console. Generate a random 32-byte secret:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Never commit a real token or share it with customers.
OPERATOR_TOKEN=
